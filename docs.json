{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "WIKI",
  "colors": {
    "primary": "#ed95a0",
    "light": "#ed95a0",
    "dark": "#ed95a0"
  },
  "favicon": {
    "light": "/images/logo(безподложкиибезсвечения).png",
    "dark": "/images/logo(безподложкиибезсвечения).png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "href": "https://discord.gg/YCJ9wweXKv",
          "icon": "discord"
        },
        {
          "anchor": "YouTube",
          "href": "https://www.youtube.com/@LotusNetwork-y9h",
          "icon": "youtube"
        }
      ]
    },
    "groups": [
      {
        "group": "НАЧАЛО ВАШЕЙ ИСТОРИИ",
        "pages": [
          "start/how-to-play",
          "start/rules",
          "start/faq"
        ]
      },
      {
        "group": "ИНФОРМАЦИЯ",
        "pages": [
          "info/about",
          "info/server-functions",
          "info/block"
        ]
      },
      {
        "group": "LOTUS ENHANCED",
        "pages": [
          "info/lotus-enhanced"
        ]
      },
      {
        "group": "ПОДДЕРЖКА ПРОЕКТА",
        "pages": [
          "support-project/lotus"
        ]
      },
      {
        "group": "ПРОЧЕЕ",
        "pages": [
          "server-configs",
          "media-kit",
          "privacy-policy"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/wikilogo.png",
    "dark": "/images/wikilogo.png",
    "href": "https://wiki.lotus-land.net"
  },
  "navbar": {
    "links": [
      {
        "label": "Поддержка",
        "href": "mailto:support@lotus-land.net"
      },
      {
        "href": "https://shop.lotus-land.net/",
        "label": "Магазин"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Онлайн карта",
      "href": "https://map.lotus-land.net/"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/YCJ9wweXKv",
      "youtube": "https://www.youtube.com/@LotusNetwork-y9h"
    }
  },
  "banner": {
    "content": "🌠 Когда мир рушится — рождается новый",
    "dismissible": false
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "grid"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "interaction": {
    "drilldown": true
  },
  "search": {
    "prompt": "Найдите то что Вас интересует..."
  },
  "fonts": {
    "family": "Arimo"
  }
}
